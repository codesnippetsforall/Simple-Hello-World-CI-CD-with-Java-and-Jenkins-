pipeline {
    agent {
        docker {
            image 'maven:3.9-eclipse-temurin-21-alpine'
            reuseNode true
        }
    }

    stages {
        stage('Build stage') {            
            agent any
            steps {
                sh '''
                    export HOME="${WORKSPACE}"
                    mkdir -p "${HOME}/.m2"
                    ls -la
                    java --version
                    mvn -v
                    mvn clean package -DskipTests
                '''
            }
        }
        
        stage('Test stage') {
            agent any
            steps {
                sh '''
                 export HOME="${WORKSPACE}"
                 mkdir -p "${HOME}/.m2"
                 ls -la
                 mvn test
                '''  
            }
        }

        stage('Deploy stage') {
            agent any
            steps {
                sh '''
                    docker stop helloworld-app || true
                    docker rm helloworld-app || true
                    docker run -d --name helloworld-app -p 8085:8085 \
                    -v "$PWD/target/helloworldwithjava-1.0.0.jar:/app/app.jar" \
                    eclipse-temurin:21-jre-alpine \
                    java -jar /app/app.jar
                    sleep 3 
                    curl http://localhost:8085/
                '''
            }
        }
    }
}
