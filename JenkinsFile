pipeline {
    agent none

    stages {
        stage('Build stage') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21-alpine'
                    reuseNode true
                }
            }
            steps {
                sh 'export HOME="${WORKSPACE}" && mkdir -p "${HOME}/.m2" && mvn clean package -DskipTests'
                stash includes: 'target/helloworldwithjava-1.0.0.jar', name: 'app-jar'
            }
        }

        stage('Test stage') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21-alpine'
                    reuseNode true
                }
            }
            steps {
                sh 'export HOME="${WORKSPACE}" && mkdir -p "${HOME}/.m2" && mvn test'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Deploy stage') {
            agent any
            options {
                skipDefaultCheckout(true)
            }
            steps {
                unstash 'app-jar'
                sh 'docker stop helloworld-app || true'
                sh 'docker rm helloworld-app || true'
                sh 'docker run -d --name helloworld-app -p 8085:8085 -v "${WORKSPACE}/target/helloworldwithjava-1.0.0.jar:/app/app.jar" eclipse-temurin:21-jre-alpine java -jar /app/app.jar'
                sh 'sleep 5'
                sh 'docker logs helloworld-app'
                sh 'curl -f --max-time 10 http://docker:8085/'
            }
        }
    }

    post {
        always {
            emailext(
                to: 'dreamcoincollection@gmail.com',
                subject: "Jenkins ${currentBuild.fullDisplayName}: ${currentBuild.currentResult}",
                body: """Hello,

Build: ${env.JOB_NAME} #${env.BUILD_NUMBER}
Result: ${currentBuild.currentResult}
URL: ${env.BUILD_URL}

Test Result: ${env.BUILD_URL}testReport/

Regards,
Jenkins
""",
                attachLog: true
            )
        }
    }
}
