pipeline {
    agent any

    stages {
        stage('Build') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    ls -la
                    java --version
                    mvn -v
                    mvn clean                  
                '''
            }
        }
        
        stage('Test & Deploy later') {
            agent {
                docker {
                    image 'eclipse-temurin:21-jre-alpine'
                    reuseNode true
                }
            }
            
            steps {
                sh '''
                 echo "Test & Deploy later !" 
                '''  
            }
        }
    }
}
