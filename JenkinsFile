pipeline {
    agent none

    stages {
        stage('Build stage') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21-alpine'
                    reuseNode true
                }
            }
            steps {
                sh 'export HOME="${WORKSPACE}" && mkdir -p "${HOME}/.m2" && mvn clean package -DskipTests'
                stash includes: 'target/Hurrayworldwithjava-1.0.0.jar', name: 'app-jar'
            }
        }

        stage('Test stage') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    export HOME="${WORKSPACE}"
                    mkdir -p "${HOME}/.m2" reports
                    mvn test
                    mvn -q surefire-report:report-only

                    {
                      echo '<html><body style="font-family:Arial,sans-serif">'
                      echo '<h2>JUnit 5 Surefire Summary</h2>'
                      echo '<pre style="background:#f6f8fa;padding:12px;border-radius:6px">'
                      cat target/surefire-reports/*.txt 2>/dev/null || echo "No txt summary found"
                      echo '</pre>'
                      echo '</body></html>'
                    } > reports/email-report.html

                    ls -la reports target/surefire-html target/surefire-reports || true
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'target/surefire-html',
                        reportFiles: 'surefire-report.html',
                        reportName: 'Surefire HTML Report'
                    ])
                    archiveArtifacts artifacts: 'reports/email-report.html,target/surefire-html/**,target/surefire-reports/*.xml', allowEmptyArchive: true
                    stash name: 'test-reports', includes: 'reports/email-report.html', allowEmpty: true
                }
            }
        }

        stage('Deploy stage') {
            agent any
            options {
                skipDefaultCheckout(true)
            }
            steps {
                unstash 'app-jar'
                sh '''
                    echo "Releasing port 8085 if already in use..."
                    ids=$(docker ps -aq --filter publish=8085)
                    if [ -n "$ids" ]; then
                      docker rm -f $ids
                    fi
                    docker rm -f Hurrayworld-app helloworld-app 2>/dev/null || true
                    docker run -d --name Hurrayworld-app -p 8085:8085 -v "${WORKSPACE}/target/Hurrayworldwithjava-1.0.0.jar:/app/app.jar" eclipse-temurin:21-jre-alpine java -jar /app/app.jar
                    sleep 5
                    docker logs Hurrayworld-app
                    curl -f --max-time 10 http://docker:8085/
                '''
            }
        }
    }

    post {
        always {
            node('built-in') {
                script {
                    def reportHtml = '<p>No test summary found.</p>'
                    try {
                        unstash 'test-reports'
                        if (fileExists('reports/email-report.html')) {
                            reportHtml = readFile('reports/email-report.html')
                        }
                    } catch (err) {
                        echo "No test reports available: ${err}"
                    }

                    mail(
                        to: 'dreamcoincollection@gmail.com',
                        subject: "Jenkins ${currentBuild.fullDisplayName}: ${currentBuild.currentResult}",
                        mimeType: 'text/html',
                        body: """
<html>
<body style="font-family:Arial,sans-serif">
<p>Hurray,</p>
<p><b>Build:</b> ${env.JOB_NAME} #${env.BUILD_NUMBER}<br/>
<b>Result:</b> ${currentBuild.currentResult}<br/>
<a href="${env.BUILD_URL}">Build URL</a> |
<a href="${env.BUILD_URL}testReport/">Jenkins Test Result</a> |
<a href="${env.BUILD_URL}Surefire_20HTML_20Report/">Surefire HTML Report</a></p>
<hr/>
${reportHtml}
</body>
</html>
"""
                    )
                }
            }
        }
    }
}
