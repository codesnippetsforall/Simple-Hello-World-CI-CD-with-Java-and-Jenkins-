pipeline {
    agent none

    environment {
        MAVEN_IMAGE       = 'maven:3.9-eclipse-temurin-21-alpine'
        RUNTIME_IMAGE     = 'eclipse-temurin:21-jre-alpine'
        APP_NAME          = 'Hurrayworld-app'
        APP_JAR           = 'Hurrayworldwithjava-1.0.0.jar'
        APP_PORT          = '8085'
        DOCKER_HOST_ALIAS = 'docker'
        STASH_APP_JAR     = 'app-jar'
        STASH_TEST_REPORTS = 'test-reports'
        EMAIL_TO          = credentials('REPORT_TO_ADDRESS_EMAIL_ID')
        REPORT_NAME       = 'Surefire HTML Report'
    }

    stages {
        stage('Build stage') {
            agent {
                docker {
                    image "${MAVEN_IMAGE}"
                    reuseNode true
                }
            }
            steps {
                sh 'export HOME="${WORKSPACE}" && mkdir -p "${HOME}/.m2" && mvn clean package -DskipTests'
                stash includes: "target/${APP_JAR}", name: "${STASH_APP_JAR}"
            }
        }

        stage('Test stage') {
            agent {
                docker {
                    image "${MAVEN_IMAGE}"
                    reuseNode true
                }
            }
            steps {
                sh '''
                    export HOME="${WORKSPACE}"
                    mkdir -p "${HOME}/.m2" reports
                    mvn test
                    mvn -q surefire-report:report-only

                    {
                      echo '<html><body style="font-family:Arial,sans-serif">'
                      echo '<h2>JUnit 5 Surefire Summary</h2>'
                      echo '<pre style="background:#f6f8fa;padding:12px;border-radius:6px">'
                      cat target/surefire-reports/*.txt 2>/dev/null || echo "No txt summary found"
                      echo '</pre>'
                      echo '</body></html>'
                    } > reports/email-report.html

                    ls -la reports target/surefire-html target/surefire-reports || true
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'target/surefire-html',
                        reportFiles: 'surefire-report.html',
                        reportName: "${REPORT_NAME}"
                    ])
                    archiveArtifacts artifacts: 'reports/email-report.html,target/surefire-html/**,target/surefire-reports/*.xml', allowEmptyArchive: true
                    stash name: "${STASH_TEST_REPORTS}", includes: 'reports/email-report.html', allowEmpty: true
                }
            }
        }

        stage('Deploy stage') {
            agent any
            options {
                skipDefaultCheckout(true)
            }
            steps {
                unstash "${STASH_APP_JAR}"
                sh '''
                    echo "Releasing port ${APP_PORT} if already in use..."
                    ids=$(docker ps -aq --filter publish=${APP_PORT})
                    if [ -n "$ids" ]; then
                      docker rm -f $ids
                    fi
                    docker rm -f "${APP_NAME}" helloworld-app 2>/dev/null || true
                    docker run -d --name "${APP_NAME}" -p ${APP_PORT}:${APP_PORT} \
                      -v "${WORKSPACE}/target/${APP_JAR}:/app/app.jar" \
                      ${RUNTIME_IMAGE} java -jar /app/app.jar
                    sleep 5
                    docker logs "${APP_NAME}"
                    curl -f --max-time 10 "http://${DOCKER_HOST_ALIAS}:${APP_PORT}/"
                '''
            }
        }
    }

    post {
        always {
            node('built-in') {
                script {
                    def reportHtml = '<p>No test summary found.</p>'
                    try {
                        unstash env.STASH_TEST_REPORTS
                        if (fileExists('reports/email-report.html')) {
                            reportHtml = readFile('reports/email-report.html')
                        }
                    } catch (err) {
                        echo "No test reports available: ${err}"
                    }

                    mail(
                        to: env.EMAIL_TO,
                        subject: "Jenkins ${currentBuild.fullDisplayName}: ${currentBuild.currentResult}",
                        mimeType: 'text/html',
                        body: """
<html>
<body style="font-family:Arial,sans-serif">
<p>Hurray,</p>
<p><b>Build:</b> ${env.JOB_NAME} #${env.BUILD_NUMBER}<br/>
<b>Result:</b> ${currentBuild.currentResult}<br/>
<a href="${env.BUILD_URL}">Build URL</a> |
<a href="${env.BUILD_URL}testReport/">Jenkins Test Result</a> |
<a href="${env.BUILD_URL}Surefire_20HTML_20Report/">Surefire HTML Report</a></p>
<hr/>
${reportHtml}
</body>
</html>
"""
                    )
                }
            }
        }
    }
}
