pipeline {
    agent any

    stages {
        stage('w/o docker') {
            steps {
                sh ' echo "Without Docker !" '
            }
        }
        
        stage('w/ docker') {
            agent {
                docker {
                    image 'eclipse-temurin:21-jre-alpine'
                    reuseNode true
                }
            }
            steps {
                sh ' echo "With Docker !" '
                sh 'java --version'
            }
        }
    }
}
