pipeline {
    agent none

    stages {
        stage('Build stage') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21-alpine'
                    reuseNode true
                }
            }
            steps {
                sh 'export HOME="${WORKSPACE}" && mkdir -p "${HOME}/.m2" && mvn clean package -DskipTests'
                stash includes: 'target/helloworldwithjava-1.0.0.jar', name: 'app-jar'
            }
        }

        stage('Test stage') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21-alpine'
                    reuseNode true
                }
            }
            steps {
                sh 'export HOME="${WORKSPACE}" && mkdir -p "${HOME}/.m2" && mvn test surefire-report:report'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                    stash name: 'test-reports', includes: 'target/surefire-reports/**,target/site/surefire-report.html', allowEmpty: true
                }
            }
        }

        stage('Deploy stage') {
            agent any
            options {
                skipDefaultCheckout(true)
            }
            steps {
                unstash 'app-jar'
                sh 'docker stop helloworld-app || true'
                sh 'docker rm helloworld-app || true'
                sh 'docker run -d --name helloworld-app -p 8085:8085 -v "${WORKSPACE}/target/helloworldwithjava-1.0.0.jar:/app/app.jar" eclipse-temurin:21-jre-alpine java -jar /app/app.jar'
                sh 'sleep 5'
                sh 'docker logs helloworld-app'
                sh 'curl -f --max-time 10 http://docker:8085/'
            }
        }
    }

    post {
        always {
            node('built-in') {
                script {
                    def reportHtml = '<p>No Surefire HTML report found.</p>'
                    try {
                        unstash 'test-reports'
                        if (fileExists('target/site/surefire-report.html')) {
                            reportHtml = readFile('target/site/surefire-report.html')
                        }
                    } catch (err) {
                        echo 'No test reports available to include in email'
                    }

                    mail(
                        to: 'dreamcoincollection@gmail.com',
                        subject: "Jenkins ${currentBuild.fullDisplayName}: ${currentBuild.currentResult}",
                        mimeType: 'text/html',
                        body: """
<html>
<body>
<p>Hello,</p>
<p><b>Build:</b> ${env.JOB_NAME} #${env.BUILD_NUMBER}<br/>
<b>Result:</b> ${currentBuild.currentResult}<br/>
<a href="${env.BUILD_URL}">Build URL</a> |
<a href="${env.BUILD_URL}testReport/">Jenkins Test Result</a></p>
<hr/>
<h3>JUnit 5 Surefire Report</h3>
${reportHtml}
</body>
</html>
"""
                    )
                }
            }
        }
    }
}
