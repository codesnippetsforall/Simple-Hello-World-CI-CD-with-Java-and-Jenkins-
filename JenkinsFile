pipeline {
    agent {
        docker {
            image 'maven:3.9-eclipse-temurin-21-alpine'
            reuseNode true
        }
    }

    stages {
        stage('Build stage') {            

            steps {
                sh '''
                    export HOME="${WORKSPACE}"
                    mkdir -p "${HOME}/.m2"
                    ls -la
                    java --version
                    mvn -v
                    mvn clean package -DskipTests
                '''
            }
        }
        
        stage('Test stage') {
            
            steps {
                sh '''
                 export HOME="${WORKSPACE}"
                 mkdir -p "${HOME}/.m2"
                 ls -la
                 mvn test
                '''  
            }
        }
    }
}
